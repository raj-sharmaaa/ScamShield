# Frontend public configuration (safe to expose in browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Backend only — never use NEXT_PUBLIC_ for these values
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./data/scamshield.db
RATE_LIMIT_PER_MINUTE=60
REDIS_URL=
FIREBASE_PROJECT_ID=
SUPABASE_URL=
CLERK_ISSUER=
CLERK_JWKS_URL=

# Optional AI explanation layer. Keep disabled unless the privacy notice is enabled.
AI_ANALYSIS_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=8
