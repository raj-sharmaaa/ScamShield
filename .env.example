# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./data/scamshield.db
# Hosted PostgreSQL connection strings (postgresql://...) are also supported
RATE_LIMIT_PER_MINUTE=60
# Public origin(s) of the deployed web app, comma-separated

# Optional AI explanation layer. Keep this disabled until a rotated provider key is configured.
AI_ANALYSIS_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=8
